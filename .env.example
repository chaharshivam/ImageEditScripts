# Framewipe local app — copy to .env next to webapp.py if you want to override defaults.
# No secrets live here. Do not put API keys in this file.

# Port the local Flask app prefers. If it is busy, the next free port in the
# same range is used. Bind is always 127.0.0.1.
FRAMEWIPE_PORT=8765

# Canonical site URL for the static landing page (landing/). Leave empty while
# you are on localhost. After you buy the domain, set this at deploy time, e.g.
#   FRAMEWIPE_SITE_URL=https://framewipe.com
# The local app does not need this.
FRAMEWIPE_SITE_URL=
